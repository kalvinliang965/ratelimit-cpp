      "policy": {"domain": "test-domain", "descriptors": [{"key": "wild", "value": "foo*bar*", "value_to_metric": true, "rate_limit": {"unit": "minute", "requests_per_unit": 20}}]},
      "requests": [{"domain": "test-domain", "entries": [["wild", "foo123bar456"]]}],
      "metric_hits": {"test-domain.wild_foo123bar456": 1}
    },
    {
      "id": "value_to_metric_detailed_metric_precedence",
      "source": "ratelimit/test/config/config_test.go:TestValueToMetric_DoesNotOverrideDetailedMetric (lines 1206-1263)",
      "policy": {"domain": "domain", "descriptors": [{"key": "route", "value_to_metric": true, "descriptors": [{"key": "http_method", "value_to_metric": true, "descriptors": [{"key": "subject_id", "detailed_metric": true, "rate_limit": {"unit": "minute", "requests_per_unit": 60}}]}]}]},
      "requests": [{"domain": "domain", "entries": [["route", "draw"], ["http_method", "GET"], ["subject_id", "123"]]}],
      "metric_hits": {"domain.route_draw.http_method_GET.subject_id_123": 1}
    },
    {
      "id": "value_to_metric_wildcard_runtime_values",
      "source": "ratelimit/test/config/config_test.go:TestValueToMetric_WithWildcard (lines 1354-1426)",
      "policy": {"domain": "domain", "descriptors": [{"key": "user", "value_to_metric": true, "descriptors": [{"key": "action", "value": "read*", "value_to_metric": true, "descriptors": [{"key": "resource", "rate_limit": {"unit": "minute", "requests_per_unit": 100}}]}]}]},
      "requests": [
        {"domain": "domain", "entries": [["user", "alice"], ["action", "readfile"], ["resource", "documents"]]},
        {"domain": "domain", "entries": [["user", "bob"], ["action", "readdata"], ["resource", "database"]]}
      ],
      "metric_hits": {
        "domain.user_alice.action_readfile.resource": 1,
        "domain.user_bob.action_readdata.resource": 1
      }
    }
  ]

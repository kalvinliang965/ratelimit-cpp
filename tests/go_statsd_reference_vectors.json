      "source": "ratelimit/test/config/config_test.go:TestWildcardStatsBehavior share_threshold subtest (lines 2050-2077)",
      "policy": {"domain": "test-domain", "descriptors": [{"key": "wild", "value": "foo*", "share_threshold": true, "rate_limit": {"unit": "minute", "requests_per_unit": 20}}]},
      "requests": [{"domain": "test-domain", "entries": [["wild", "foo1"]]}],
      "metric_hits": {"test-domain.wild_foo*": 1}
    },
    {
      "id": "wildcard_share_threshold_value_to_metric",
      "source": "ratelimit/test/config/config_test.go:TestWildcardStatsBehavior share_threshold/value_to_metric priority subtest (lines 2079-2112)",
      "policy": {"domain": "test-domain", "descriptors": [{"key": "wild", "value": "foo*", "share_threshold": true, "value_to_metric": true, "rate_limit": {"unit": "minute", "requests_per_unit": 20}}]},
      "requests": [{"domain": "test-domain", "entries": [["wild", "foo1"]]}],
      "metric_hits": {"test-domain.wild_foo*": 1}
    },
    {
      "id": "wildcard_other_value_to_metric",
      "source": "ratelimit/test/config/config_test.go:TestWildcardStatsBehavior value_to_metric-in-other-descriptor subtest (lines 2114-2157)",
      "policy": {"domain": "test-domain", "descriptors": [{"key": "wild", "value": "foo*", "descriptors": [{"key": "other", "value_to_metric": true, "descriptors": [{"key": "limit", "rate_limit": {"unit": "minute", "requests_per_unit": 20}}]}]}]},
      "requests": [{"domain": "test-domain", "entries": [["wild", "foo1"], ["other", "bar"], ["limit", "X"]]}],
      "metric_hits": {"test-domain.wild_foo*.other_bar.limit": 1}
    },
    {
      "id": "middle_trailing_wildcard_no_flags",
      "source": "ratelimit/test/config/config_test.go:TestWildcardStatsBehavior middle+trailing no-flags subtest (lines 2163-2186)",
      "policy": {"domain": "test-domain", "descriptors": [{"key": "wild", "value": "foo*bar*", "rate_limit": {"unit": "minute", "requests_per_unit": 20}}]},
      "requests": [
        {"domain": "test-domain", "entries": [["wild", "foo123bar456"]]},
        {"domain": "test-domain", "entries": [["wild", "fooXbarY"]]}
